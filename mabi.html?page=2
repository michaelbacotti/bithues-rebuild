 <script>
(function() {
  var bar = document.querySelector('.genre-filter-bar');
  if (!bar) return;
  bar.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var genre = btn.getAttribute('data-value');
      bar.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.article-card[data-genre]').forEach(function(card) {
        card.style.display = (genre === 'all' || card.getAttribute('data-genre') === genre) ? '' : 'none';
      });
    });
  });
})();
 </script>

